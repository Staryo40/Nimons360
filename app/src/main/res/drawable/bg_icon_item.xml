<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected: teal 12% fill + 2dp teal border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F006D77" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_teal" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

    <!-- Default: white fill + 1dp subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

</selector>
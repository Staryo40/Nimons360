<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:id="@+id/tvQrTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/share_family_qr_code"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQrFamilyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        tools:text="Maulana Family" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@drawable/bg_qr_preview"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:contentDescription="@string/share_family_qr_code"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_qr_code" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvQrInviteCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:textColor="@color/primary_teal"
        android:textSize="@dimen/text_xl"
        android:textStyle="bold"
        tools:text="ABC123" />

    <TextView
        android:id="@+id/tvQrLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_sm"
        tools:text="nimons360://family/41?code=ABC123" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center"
        android:text="@string/qr_preview_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareQr"
        style="@style/Widget.Nimons360.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/share_family_qr" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseQr"
        style="@style/Widget.Nimons360.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/btn_close" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_base"
    tools:context=".ui.features.families.CreateFamilyFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_sm"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="New Family"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCreate"
                app:layout_constraintStart_toEndOf="@id/btnCancel"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnCreate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_md"
                android:text="Create"
                android:textColor="@color/primary_teal"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:dividerColor="@color/divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_xxl">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_xl"
                    android:paddingBottom="@dimen/spacing_md">

                    <ImageView
                        android:id="@+id/ivSelectedIcon"
                        android:layout_width="@dimen/family_icon_lg"
                        android:layout_height="@dimen/family_icon_lg"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_icon_item"
                        android:contentDescription="@string/cd_family_icon"
                        android:padding="@dimen/spacing_sm"
                        android:scaleType="fitCenter"
                        tools:src="@mipmap/ic_launcher" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_horizontal_padding"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="FAMILY NAME"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:letterSpacing="0.08" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFamilyName"
                    style="@style/Widget.Nimons360.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_horizontal_padding"
                    android:hint="@string/family_name_hint"
                    app:counterEnabled="true"
                    app:counterMaxLength="40">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFamilyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="40"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_horizontal_padding"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="After creating the family, an auto-generated family code will be produced. Members will need to enter this code to join."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_horizontal_padding"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="CHOOSE AN ICON"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_horizontal_padding"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/iconContainer1"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_horizontal_padding"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/iconContainer5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon7"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <Space android:layout_width="@dimen/spacing_sm" android:layout_height="1dp" />

                    <FrameLayout
                        android:id="@+id/iconContainer8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm">
                        <ImageView
                            android:id="@+id/ivIcon8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/cd_family_icon"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_horizontal_padding"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_error_banner"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:textColor="@color/danger_crimson"
                    android:textSize="@dimen/text_sm"
                    android:visibility="gone"
                    tools:text="Something went wrong."
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_teal" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

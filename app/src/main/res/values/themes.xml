<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nimons360" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary brand: Deep Teal -->
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_teal_light</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary: Soft Coral -->
        <item name="colorSecondary">@color/secondary_coral</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_coral</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary</item>

        <!-- Surfaces & backgrounds -->
        <item name="android:colorBackground">@color/background_base</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error / destructive -->
        <item name="colorError">@color/danger_crimson</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar matches teal header -->
        <item name="android:statusBarColor">@color/primary_teal</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ── Login Activity ─────────────────────────────────────────────── -->
    <!--
        Same as base but uses a white/off-white background and
        light status bar so dark icons are visible.
    -->
    <style name="Theme.Nimons360.Login" parent="Theme.Nimons360">
        <item name="android:statusBarColor">@color/background_base</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ── Shared XML widget overrides ───────────────────────────────── -->

    <!-- OutlinedBox TextInputLayout using brand tint -->
    <style name="Widget.Nimons360.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_teal</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Primary filled button -->
    <style name="Widget.Nimons360.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Destructive / danger text button (Sign Out, Leave Family) -->
    <style name="Widget.Nimons360.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/ripple_danger</item>
        <item name="android:textColor">@color/danger_crimson</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Secondary / accent tonal button (Join) -->
    <style name="Widget.Nimons360.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/secondary_coral</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Card surface -->
    <style name="Widget.Nimons360.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
    </style>

    <!-- Headline text (Family Name, User Name) -->
    <style name="TextAppearance.Nimons360.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body text -->
    <style name="TextAppearance.Nimons360.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Family code display box -->
    <style name="Widget.Nimons360.FamilyCode" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/secondary_coral</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Profile -->
    <style name="Theme.Nimons360.ProfileDialog" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/ProfileAnimation</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="ProfileAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
